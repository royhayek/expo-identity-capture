{
  "name": "expo-identity-capture",
  "version": "2.7.6",
  "description": "Identity document and selfie capture for Expo / React Native apps: live document scanning with auto capture, on-device MRZ reading, and a head-turn selfie liveness check.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "npm run clean && nitrogen && tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf lib",
    "prepack": "npm run build",
    "specs": "nitrogen"
  },
  "keywords": [
    "react-native",
    "expo",
    "identity",
    "capture",
    "camera",
    "document",
    "selfie",
    "kyc",
    "mrz",
    "ocr",
    "liveness",
    "vision-camera",
    "nitro"
  ],
  "author": "Roy El Hayek",
  "license": "MIT",
  "peerDependencies": {
    "expo": ">=57.0.0",
    "expo-camera": ">=57.0.0",
    "expo-file-system": ">=57.0.0",
    "expo-image-manipulator": ">=57.0.0",
    "expo-text-extractor": ">=2.0.0",
    "react": ">=19.2.0",
    "react-native": ">=0.85.0",
    "react-native-document-scanner-plugin": ">=2.0.4",
    "react-native-fast-opencv": ">=1.0.1",
    "react-native-nitro-image": ">=0.15.2",
    "react-native-nitro-modules": ">=0.37.0",
    "react-native-svg": ">=15.12.0",
    "react-native-vision-camera": ">=5.2.4",
    "react-native-vision-camera-worklets": ">=5.2.4",
    "react-native-worklets": ">=0.10.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "expo": "~57.0.29",
    "expo-camera": "~57.0.6",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-text-extractor": "^2.0.0",
    "jest": "^29.7.0",
    "nitrogen": "^0.37.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-document-scanner-plugin": "2.0.4",
    "react-native-fast-opencv": "1.0.1",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.2.4",
    "react-native-vision-camera-worklets": "5.2.4",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3"
  },
  "files": [
    "lib",
    "src",
    "ios",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "nitrogen",
    "nitro.json",
    "ExpoIdentityCapture.podspec",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royhayek/expo-identity-capture.git"
